# labwc config — Compositor Wayland para Lume OS Core amd64
# Materiais: Névoa + Sólido + sombras (2 camadas)

# Teclas de atalho
bind = SUPER, Q, exec, foot
bind = SUPER, E, exec, lume-files
bind = SUPER, S, exec, lume-settings
bind = SUPER, L, exec, lume-shield --lock
bind = SUPER, D, exec, sudo systemctl poweroff
bind = SUPER, R, exec, sudo systemctl reboot
bind = SUPER, TAB, exec, lume-overview
bind = ALT, TAB, exec, lume-alt-tab

# Snap layouts
bind = SUPER, LEFT, snap, left
bind = SUPER, RIGHT, snap, right
bind = SUPER, UP, snap, top
bind = SUPER, DOWN, snap, bottom

# Configurações gerais
focus_follows_mouse = true
focus_wraps = true
empty_border = true
empty_padding = 5

# Decorações de janela
border_width = 2
border_color = #1e293b
border_color_focused = #3e8ef7

# Sombras (2 camadas para Core)
shadow_color = #000000
shadow_blur = 8
shadow_offset_x = 4
shadow_offset_y = 4
shadow_opacity = 0.3

# Painéis/barcos
bar = /usr/share/lume/config/core/labwc-bar.sh

