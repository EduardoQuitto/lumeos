# labwc config — Lume OS Core Edition
# Materiais: Névoa + Sólido + sombras
# Idle target: ≤350 MB

# Wayland compositor
xwayland = true

# Lacros-style decorations enabled
decoration = {
  border_size = 1
  border_color = #1e293b
  active_border_color = #3E8EF7
  active_text_color = #F7F9FC
  inactive_text_color = #94A3B8
  titlebar_height = 40
  font_family = Inter
  font_size = 13
}

# Lume themes
theme {
  surfaces = [ "Névoa", "Sólido" ]
  shadow_layers = 2
  border_radius = 12
  blur_enabled = true
  blur_passes = 3
}

# Keybindings
bindmod = Super

bind {
  bindmod, Q, exec, lume-files
  bindmod, I, exec, lume-settings
  bindmod, T, exec, foot
  bindmod, L, exec, loginctl lock-session
  bindmod, Tab, exec, lume-overview
  bindmod, A, exec, lume-alt-tab
}

# Startup
exec-once = openbox --config-file /etc/xdg/openbox/lume-core-rc.xml
exec-once = picom --config /usr/share/lume/config/lite/picom.conf --backend glx --daemon
