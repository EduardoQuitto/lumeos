# Lume OS — Acessibilidade: Orca Screen Reader
# Configuração para deficientes visuais

[orca]
enabled = true
voice_rate = 50
voice_pitch = 50
voice_volume = 100
punctuation_level = some
echo_keys = true
echo_mouse = true
echo_typing = true

[keyboard]
sticky_keys = true
slow_keys = false
bounce_keys = false
mouse_keys = false
