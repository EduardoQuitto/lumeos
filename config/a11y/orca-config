# Lume OS - Orca Screen Reader Configuration
# Requisitos fase 24:
#   - Orca screen reader configurado e pronto para uso

[orca]
enabled = true
language = pt-BR
voice_rate = 50
voice_pitch = 50
voice_volume = 100

[braille]
enabled = false
table = english-us

[echo]
character = false
word = true
sentence = true

[focus_tracking]
enabled = true
follow_focus = true

[visual]
high_contrast = false
font_size = large

[keyboard]
echo_keys = true
echo_modifiers = true

[mouse]
tracking = false
follow_mouse = false

[announcements]
focus_change = true
mouse_over = false
live_region = true
