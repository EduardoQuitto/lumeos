[Unit]
Description=Lume OS session limit timer (5 h)
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/bin/curl -s -X POST http://localhost:7777/api/control -H 'Content-Type: application/json' -d '{"pausada":true}'
ExecStartPost=/usr/bin/curl -s -X POST http://localhost:7777/api/events -H 'Content-Type: application/json' -d '{"tipo":"report_daily","payload":{"sessao":"5h","status":"encerrado_por_timer"}}'
WorkingDirectory=/w/lume-os

[Install]
WantedBy=multi-user.target
